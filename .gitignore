# dependencies
/node_modules
/.pnp
.pnp.*

# next
/.next/
/out/
/build
next-env.d.ts

# misc
.DS_Store
*.pem
/coverage

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env
.env*
!.env.example

# vercel / typescript
.vercel
*.tsbuildinfo

# Figma metadata dumps — regenerate with get_metadata, do not commit
/.figma/

# Raw Figma exports. These are the INPUT to tools/optimize-assets.mjs and are
# large PNGs; the committed WebP masters under public/images are the artefact
# that matters. Figma's asset URLs expire after ~7 days, so if these are ever
# needed again they must be re-pulled from the file, not from a link.
/assets-src/

# Re-allow the committed, optimised media.
!/public/images/
!/public/icons/
!/public/fonts/
